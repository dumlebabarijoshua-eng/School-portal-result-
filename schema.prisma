generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { STUDENT TEACHER ADMIN }
enum UserStatus { ACTIVE DISABLED }
enum ResultStatus { DRAFT SUBMITTED APPROVED PUBLISHED UNPUBLISHED }
model User { id String @id @default(cuid()); username String @unique; email String? @unique; passwordHash String; role Role; status UserStatus @default(ACTIVE); student Student?; teacher Teacher?; auditLogs AuditLog[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Student { id String @id @default(cuid()); userId String @unique; matricNumber String @unique; admissionNumber String? @unique; firstName String; middleName String?; lastName String; gender String?; phone String?; email String?; address String?; stateOfOrigin String?; localGovernment String?; level String?; classId String?; departmentId String?; user User @relation(fields:[userId],references:[id],onDelete:Cascade); class Class? @relation(fields:[classId],references:[id]); department Department? @relation(fields:[departmentId],references:[id]); results Result[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Teacher { id String @id @default(cuid()); userId String @unique; staffId String @unique; firstName String; lastName String; email String?; phone String?; departmentId String?; user User @relation(fields:[userId],references:[id],onDelete:Cascade); department Department? @relation(fields:[departmentId],references:[id]); assignments TeacherAssignment[]; resultsEntered Result[] @relation("EnteredResults"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Department { id String @id @default(cuid()); name String @unique; code String @unique; classes Class[]; students Student[]; teachers Teacher[]; subjects Subject[] }
model Class { id String @id @default(cuid()); name String; level String; departmentId String?; department Department? @relation(fields:[departmentId],references:[id]); students Student[]; assignments TeacherAssignment[]; results Result[]; @@unique([name,level]) }
model Subject { id String @id @default(cuid()); code String @unique; name String; creditUnit Int?; level String?; departmentId String?; department Department? @relation(fields:[departmentId],references:[id]); assignments TeacherAssignment[]; results Result[] }
model AcademicSession { id String @id @default(cuid()); name String @unique; startDate DateTime; endDate DateTime; active Boolean @default(false); terms Term[]; results Result[]; assignments TeacherAssignment[] }
model Term { id String @id @default(cuid()); name String; academicSessionId String; academicSession AcademicSession @relation(fields:[academicSessionId],references:[id],onDelete:Cascade); results Result[]; assignments TeacherAssignment[]; @@unique([name,academicSessionId]) }
model TeacherAssignment { id String @id @default(cuid()); teacherId String; subjectId String; classId String; academicSessionId String; termId String; teacher Teacher @relation(fields:[teacherId],references:[id],onDelete:Cascade); subject Subject @relation(fields:[subjectId],references:[id]); class Class @relation(fields:[classId],references:[id]); academicSession AcademicSession @relation(fields:[academicSessionId],references:[id]); term Term @relation(fields:[termId],references:[id]); @@unique([teacherId,subjectId,classId,termId]) }
model Result { id String @id @default(cuid()); studentId String; subjectId String; classId String; academicSessionId String; termId String; caScore Float @default(0); examScore Float @default(0); totalScore Float @default(0); grade String?; gradePoint Float?; remark String?; status ResultStatus @default(DRAFT); enteredById String?; approvedById String?; publishedAt DateTime?; student Student @relation(fields:[studentId],references:[id],onDelete:Cascade); subject Subject @relation(fields:[subjectId],references:[id]); class Class @relation(fields:[classId],references:[id]); academicSession AcademicSession @relation(fields:[academicSessionId],references:[id]); term Term @relation(fields:[termId],references:[id]); enteredBy Teacher? @relation("EnteredResults",fields:[enteredById],references:[id]); @@unique([studentId,subjectId,termId]) }
model GradingScale { id String @id @default(cuid()); name String @unique; minScore Float; maxScore Float; grade String; point Float; remark String }
model SchoolSettings { id String @id @default(cuid()); schoolName String; shortName String?; motto String?; address String?; phone String?; email String?; website String?; logoUrl String?; resultFooter String?; mode String @default("SECONDARY") }
model AuditLog { id String @id @default(cuid()); userId String?; action String; entity String; entityId String?; description String; ipAddress String?; user User? @relation(fields:[userId],references:[id],onDelete:SetNull); createdAt DateTime @default(now()) }
